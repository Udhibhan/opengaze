{
  "name": "opengaze",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source, webcam-only eye-gaze communication (AAC) with Claude-powered replies.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "postinstall": "node scripts/copy-wasm.mjs",
    "license-check": "node scripts/license-check.mjs",
    "notices": "node scripts/license-check.mjs --notices",
    "secret-scan": "node scripts/secret-scan.mjs",
    "build:extension": "node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
