{
  "manifest_version": 3,
  "name": "OpenGaze: eye control for any website",
  "short_name": "OpenGaze",
  "version": "0.1.0",
  "description": "Free, open-source eye-gaze control for any website using your webcam. Look to click, scroll and type. Video never leaves your computer.",
  "permissions": ["offscreen", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "extension/popup.html", "default_title": "OpenGaze" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
